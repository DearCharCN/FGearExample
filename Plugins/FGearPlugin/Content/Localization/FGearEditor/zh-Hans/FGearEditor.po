msgid "Throttle Range"
msgstr "Throttle Range（油门范围）"

#. Key:	FGearStandardInput:mThrottleRange
#. SourceLocation:	/Script/FGearPlugin.FGearStandardInput:mThrottleRange [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearStandardInput:mThrottleRange [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearStandardInput:mThrottleRange"
msgid "The percentage of throttle range. Works similar to steering range."
msgstr "The percentage of throttle range. Works similar to steering range.\n油门范围的百分比。工作方式与转向范围类似。"

#. Key:	FGearStandardInput:mThrottleSensivity
#. SourceLocation:	/Script/FGearPlugin.FGearStandardInput:mThrottleSensivity [FloatProperty DisplayName meta-data]
