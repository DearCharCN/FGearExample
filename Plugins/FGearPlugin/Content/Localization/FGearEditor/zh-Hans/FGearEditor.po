#. Key:	FGearWheelOptions:mBrakeTorque
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mBrakeTorque [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mBrakeTorque [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mBrakeTorque"
msgid "Brake Torque"
msgstr "Brake Torque（制动扭矩）"

#. Key:	FGearWheelOptions:mBrakeTorque
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mBrakeTorque [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mBrakeTorque [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mBrakeTorque"
msgid "Brake torque applied when the braking input is %100. If you need more torque for handbrakes, there is a parameter for that in General Settings."
msgstr "Brake torque applied when the braking input is %100. If you need more torque for handbrakes, there is a parameter for that in General Settings.\n制动输入为 100% 时施加的制动扭矩。如果手刹需要更大的扭矩，可使用通用设置中的相应参数。"

#. Key:	FGearWheelOptions:mCastOffset
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mCastOffset [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mCastOffset [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mCastOffset"
msgid "Cast Offset"
msgstr "Cast Offset（投射偏移）"

#. Key:	FGearWheelOptions:mCastOffset
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mCastOffset [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mCastOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mCastOffset"
msgid "This is an offset along the suspension normal. Use a positive value to offset the origin of ray/shape casts. If your wheels get stuck under ground when it falls from height then you can try using this. Do not use a large value, try to keep the cast origins inside vehicle hull."
msgstr "This is an offset along the suspension normal. Use a positive value to offset the origin of ray/shape casts. If your wheels get stuck under ground when it falls from height then you can try using this. Do not use a large value, try to keep the cast origins inside vehicle hull.\n沿悬架法线方向的偏移。正值会偏移射线或形状投射的起点。若车轮从高处落下后卡在地下，可以尝试使用此项。不要设置过大，尽量让投射起点保持在车身内部。"

#. Key:	FGearWheelOptions:mCompressionDamper
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mCompressionDamper [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mCompressionDamper [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mCompressionDamper"
msgid "Compression Damper (N/ms)"
msgstr "Compression Damper (N/ms)（压缩阻尼）"

#. Key:	FGearWheelOptions:mCompressionDamper
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mCompressionDamper [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mCompressionDamper [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mCompressionDamper"
msgid "Suspension compression damper force per 1 ms velocity. This value is used when suspension is compressing and it absorbs some of the spring force and reduces suspension oscillations"
msgstr "Suspension compression damper force per 1 ms velocity. This value is used when suspension is compressing and it absorbs some of the spring force and reduces suspension oscillations\n悬架每单位速度（m/s）对应的压缩阻尼力。悬架压缩时使用此值，以吸收部分弹簧力并减少悬架振荡。"

#. Key:	FGearWheelOptions:mForwardOffset
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mForwardOffset [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mForwardOffset [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mForwardOffset"
msgid "Forward Offset"
msgstr "Forward Offset（前向偏移）"

#. Key:	FGearWheelOptions:mForwardOffset
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mForwardOffset [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mForwardOffset [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mForwardOffset"
msgid "A positive forward offset(in meters) will move the wheels towards +X direction in local space."
msgstr "A positive forward offset(in meters) will move the wheels towards +X direction in local space.\n正的前向偏移（单位：米）会使车轮沿局部空间的 +X 方向移动。"

#. Key:	FGearWheelOptions:mLateralFriction
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLateralFriction [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLateralFriction [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mLateralFriction"
msgid "Lateral Friction"
msgstr "Lateral Friction（横向摩擦）"

#. Key:	FGearWheelOptions:mLateralFriction
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLateralFriction [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLateralFriction [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mLateralFriction"
msgid "The output of the tire models lateral force is multiplied with this value. Even if you use large values the final tire force will be limited."
msgstr "The output of the tire models lateral force is multiplied with this value. Even if you use large values the final tire force will be limited.\n轮胎模型输出的横向力乘以此值。即使使用很大的数值，最终轮胎力仍会受到限制。"

#. Key:	FGearWheelOptions:mLateralScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLateralScale [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLateralScale [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mLateralScale"
msgid "(Fx)Lateral Force Scale"
msgstr "(Fx)Lateral Force Scale（横向力缩放）"

#. Key:	FGearWheelOptions:mLateralScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLateralScale [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLateralScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mLateralScale"
msgid "The final lateral tire force is multiplied with this value"
msgstr "The final lateral tire force is multiplied with this value\n最终的横向轮胎力乘以此值。"

#. Key:	FGearWheelOptions:mLongitudinalFriction
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLongitudinalFriction [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLongitudinalFriction [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mLongitudinalFriction"
msgid "Longitudinal Friction"
msgstr "Longitudinal Friction（纵向摩擦）"

#. Key:	FGearWheelOptions:mLongitudinalFriction
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLongitudinalFriction [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLongitudinalFriction [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mLongitudinalFriction"
msgid "The output of the tire models longitudinal force is multiplied with this value. Even if you use large values the final tire force will be limited."
msgstr "The output of the tire models longitudinal force is multiplied with this value. Even if you use large values the final tire force will be limited.\n轮胎模型输出的纵向力乘以此值。即使使用很大的数值，最终轮胎力仍会受到限制。"

#. Key:	FGearWheelOptions:mLongitudinalScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLongitudinalScale [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLongitudinalScale [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mLongitudinalScale"
msgid "(Fy)Longitudinal Force Scale"
msgstr "(Fy)Longitudinal Force Scale（纵向力缩放）"

#. Key:	FGearWheelOptions:mLongitudinalScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mLongitudinalScale [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mLongitudinalScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mLongitudinalScale"
msgid "The final longitudinal tire force is multiplied with this value"
msgstr "The final longitudinal tire force is multiplied with this value\n最终的纵向轮胎力乘以此值。"

#. Key:	FGearWheelOptions:mMass
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mMass [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mMass [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mMass"
msgid "Mass"
msgstr "Mass（质量）"

#. Key:	FGearWheelOptions:mMass
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mMass [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mMass [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mMass"
msgid "Represents the mass of the wheel and used for calculating the rotational acceleration of the wheels. Lower mass wheels tend to spin more and higher mass wheels spin less. Too small values usually result jittery behaviour and too high values limit accelerations so try to experiment and find logical values"
msgstr "Represents the mass of the wheel and used for calculating the rotational acceleration of the wheels. Lower mass wheels tend to spin more and higher mass wheels spin less. Too small values usually result jittery behaviour and too high values limit accelerations so try to experiment and find logical values\n车轮质量，用于计算车轮的旋转加速度。质量较小的车轮更容易空转，质量较大的车轮则较少空转。数值过小通常会造成抖动，过大则限制加速，因此应通过试验选取合理值。"

#. Key:	FGearWheelOptions:mOverturnScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mOverturnScale [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mOverturnScale [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearWheelOptions:mOverturnScale"
msgid "(Mx)Over-Turn Moment Scale"
msgstr "(Mx)Over-Turn Moment Scale（翻转力矩缩放）"

#. Key:	FGearWheelOptions:mOverturnScale
#. SourceLocation:	/Script/FGearPlugin.FGearWheelOptions:mOverturnScale [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearWheelOptions:mOverturnScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearWheelOptions:mOverturnScale"
msgid "The final X-Axis moment is multiplied with this"
