#. Key:	FGearTransmission:mAutoChange
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mAutoChange [BoolProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mAutoChange [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mAutoChange"
msgid "When set to true gears are changed automatically according to the gear up/down values."
msgstr "When set to true gears are changed automatically according to the gear up/down values."

#. Key:	FGearTransmission:mAutoClutch
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mAutoClutch [BoolProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mAutoClutch [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mAutoClutch"
msgid "Auto Clutch"
msgstr "Auto Clutch"

#. Key:	FGearTransmission:mAutoClutch
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mAutoClutch [BoolProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mAutoClutch [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mAutoClutch"
msgid "When set to true the transmission automatically manages the clutch input for you. Set this to false if you want to manually operate the clutch."
msgstr "When set to true the transmission automatically manages the clutch input for you. Set this to false if you want to manually operate the clutch."

#. Key:	FGearTransmission:mAutoReverse
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mAutoReverse [BoolProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mAutoReverse [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mAutoReverse"
msgid "Auto Reverse"
msgstr "Auto Reverse"

#. Key:	FGearTransmission:mAutoReverse
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mAutoReverse [BoolProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mAutoReverse [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mAutoReverse"
msgid "When set to true the transmission automatically goes to rear gear when you brake and stop. Also the same thing happens when you are going backwards and push the throttle, this time the transmission automatically goes to first gear. This is only active when Auto Change is set."
msgstr "When set to true the transmission automatically goes to rear gear when you brake and stop. Also the same thing happens when you are going backwards and push the throttle, this time the transmission automatically goes to first gear. This is only active when Auto Change is set."

#. Key:	FGearTransmission:mChangeTime
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mChangeTime [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mChangeTime [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mChangeTime"
msgid "Change Time"
msgstr "Change Time"

#. Key:	FGearTransmission:mChangeTime
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mChangeTime [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mChangeTime [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mChangeTime"
msgid "When a gear change happens first the transmission goes to neutral and then switches to the next gear, this value determines how long this process takes in miliseconds."
msgstr "When a gear change happens first the transmission goes to neutral and then switches to the next gear, this value determines how long this process takes in miliseconds."

#. Key:	FGearTransmission:mClutchAssist
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchAssist [BoolProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchAssist [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mClutchAssist"
msgid "Stall Assist"
msgstr "Stall Assist"

#. Key:	FGearTransmission:mClutchAssist
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchAssist [BoolProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchAssist [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mClutchAssist"
msgid "This is an experimental feature. When you first launch the vehicle or when you try to climb a steep slope,\n          the rpm can stay at a low level until you reach a certain speed since there is not enough torque and there is no engine stalling.\n              This is quite observable when you have a long first fear ratio. This assist will scale the power of the clutch in order to fight with this behavior.\n              With lower clutch power the rpm can rise up and you can get receive more torque from the engine resulting faster accelerations.\n              This is only activated with the first(1) and the rear(R) gears."
msgstr "This is an experimental feature. When you first launch the vehicle or when you try to climb a steep slope,\n          the rpm can stay at a low level until you reach a certain speed since there is not enough torque and there is no engine stalling.\n              This is quite observable when you have a long first fear ratio. This assist will scale the power of the clutch in order to fight with this behavior.\n              With lower clutch power the rpm can rise up and you can get receive more torque from the engine resulting faster accelerations.\n              This is only activated with the first(1) and the rear(R) gears."

#. Key:	FGearTransmission:mClutchScale
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchScale [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchScale [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mClutchScale"
msgid "Clutch Power Scale (%)"
msgstr "Clutch Power Scale (%)"

#. Key:	FGearTransmission:mClutchScale
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchScale [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchScale [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mClutchScale"
msgid "This is a coefficient to the power transfer of the clutch(between the engine and the wheels). Do not change it if you really need to. Lower values will result high differences between engine and wheel rpms. Higher values will force both rpm values to be in sync but the engine rpm can behave erratic."
msgstr "This is a coefficient to the power transfer of the clutch(between the engine and the wheels). Do not change it if you really need to. Lower values will result high differences between engine and wheel rpms. Higher values will force both rpm values to be in sync but the engine rpm can behave erratic."

#. Key:	FGearTransmission:mClutchScaleMax
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchScaleMax [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchScaleMax [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mClutchScaleMax"
msgid "Clutch Scale Max (%)"
msgstr "Clutch Scale Max (%)"

#. Key:	FGearTransmission:mClutchScaleMin
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchScaleMin [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchScaleMin [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mClutchScaleMin"
msgid "Clutch Scale Min (%)"
msgstr "Clutch Scale Min (%)"

#. Key:	FGearTransmission:mClutchTime
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchTime [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchTime [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mClutchTime"
msgid "Clutch Engage Time"
msgstr "Clutch Engage Time"

#. Key:	FGearTransmission:mClutchTime
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mClutchTime [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mClutchTime [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mClutchTime"
msgid "Before changing gears, the clutch is fully disengaged. After gear change is completed, it takes this amount of time to reengage the clutch. Usually this value should be equal or lower than the change time."
msgstr "Before changing gears, the clutch is fully disengaged. After gear change is completed, it takes this amount of time to reengage the clutch. Usually this value should be equal or lower than the change time."

#. Key:	FGearTransmission:mGearDownRatio
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearDownRatio [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearDownRatio [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mGearDownRatio"
msgid "Gear Down Ratio"
msgstr "Gear Down Ratio"

#. Key:	FGearTransmission:mGearDownRatio
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearDownRatio [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearDownRatio [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mGearDownRatio"
msgid "Suppose you drive in 2nd gear, the maximum speed that you can achieve with the previous gear(1st) is calculated(mxs) and if you go below (geardown ratio * mxs) then the gear is changed"
msgstr "Suppose you drive in 2nd gear, the maximum speed that you can achieve with the previous gear(1st) is calculated(mxs) and if you go below (geardown ratio * mxs) then the gear is changed"

#. Key:	FGearTransmission:mGearDownVelocityBias
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearDownVelocityBias [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearDownVelocityBias [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mGearDownVelocityBias"
msgid "Gear Down Velocity Bias"
msgstr "Gear Down Velocity Bias"

#. Key:	FGearTransmission:mGearDownVelocityBias
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearDownVelocityBias [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearDownVelocityBias [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mGearDownVelocityBias"
msgid "Gear(down) change can be based on vehicle's velocity or the wheel speed. If this is zero it will be %100 based on wheel speed and if this is 1 then it will be %100 based on velocity."
msgstr "Gear(down) change can be based on vehicle's velocity or the wheel speed. If this is zero it will be %100 based on wheel speed and if this is 1 then it will be %100 based on velocity."

#. Key:	FGearTransmission:mGearRatios
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearRatios [ArrayProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearRatios [ArrayProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mGearRatios"
msgid "Gear Ratios"
msgstr "Gear Ratios"

#. Key:	FGearTransmission:mGearRatios
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearRatios [ArrayProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearRatios [ArrayProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mGearRatios"
msgid "This is an array of values which are used for calculating the final transmission ratio along with final drive. If you need a 5 speed car then the size should be 6 with the addition of rear gear. So the first 5 values are forward ratios and the last one is the rear gear ratio. All values should be positive and you can find real cars values on the internet. The default vehicle has only 1 forward and 1 backward gear so you can try the values in the image above."
msgstr "This is an array of values which are used for calculating the final transmission ratio along with final drive. If you need a 5 speed car then the size should be 6 with the addition of rear gear. So the first 5 values are forward ratios and the last one is the rear gear ratio. All values should be positive and you can find real cars values on the internet. The default vehicle has only 1 forward and 1 backward gear so you can try the values in the image above."

#. Key:	FGearTransmission:mGearUpRatio
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearUpRatio [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearUpRatio [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mGearUpRatio"
msgid "Gear Up Ratio"
msgstr "Gear Up Ratio"

#. Key:	FGearTransmission:mGearUpRatio
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearUpRatio [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearUpRatio [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mGearUpRatio"
msgid "Suppose you drive in 1st gear, the maximum speed that you can achieve with this gear is calculated(mxs) and if you go over (gearup ratio * mxs) then the gear is changed"
msgstr "Suppose you drive in 1st gear, the maximum speed that you can achieve with this gear is calculated(mxs) and if you go over (gearup ratio * mxs) then the gear is changed"

#. Key:	FGearTransmission:mGearUpVelocityBias
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearUpVelocityBias [FloatProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearUpVelocityBias [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,FGearTransmission:mGearUpVelocityBias"
msgid "Gear Up Velocity Bias"
msgstr "Gear Up Velocity Bias"

#. Key:	FGearTransmission:mGearUpVelocityBias
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mGearUpVelocityBias [FloatProperty ToolTip meta-data]
#: /Script/FGearPlugin.FGearTransmission:mGearUpVelocityBias [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,FGearTransmission:mGearUpVelocityBias"
msgid "Gear(up) change can be based on vehicle's velocity or the wheel speed. If this is zero it will be %100 based on wheel speed and if this is 1 then it will be %100 based on velocity."
msgstr "Gear(up) change can be based on vehicle's velocity or the wheel speed. If this is zero it will be %100 based on wheel speed and if this is 1 then it will be %100 based on velocity."

#. Key:	FGearTransmission:mRevMatching
#. SourceLocation:	/Script/FGearPlugin.FGearTransmission:mRevMatching [BoolProperty DisplayName meta-data]
#: /Script/FGearPlugin.FGearTransmission:mRevMatching [BoolProperty DisplayName meta-data]
