; Template expanded by Scripts/Localize-FGear.ps1. Paths follow the plugin location.
[CommonSettings]
ModulesToPreload=FGearPlugin
SourcePath=@PLUGIN_DIR@/Content/Localization/FGearEditor
DestinationPath=@PLUGIN_DIR@/Content/Localization/FGearEditor
ManifestName=FGearEditor.manifest
ArchiveName=FGearEditor.archive
NativeCulture=en
CulturesToGenerate=zh-Hans
CulturesToGenerate=en

[GatherTextStep0]
CommandletClass=GatherTextFromMetadata
IncludePathFilters=@PLUGIN_DIR@/Source/FGearPlugin/*
InputKeys=DisplayName
InputKeys=ToolTip
InputKeys=Category
OutputNamespaces=UObjectDisplayNames
OutputNamespaces=UObjectToolTips
OutputNamespaces=UObjectCategory
OutputKeys="{FieldPath}"
OutputKeys="{FieldPath}"
OutputKeys="{MetaDataValue}"
FieldTypesToInclude=Property
FieldOuterTypesToExclude=Function
ShouldGatherFromEditorOnlyData=true

[GatherTextStep1]
CommandletClass=GenerateGatherManifest

[GatherTextStep2]
CommandletClass=GenerateGatherArchive
